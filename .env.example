# Global Environment Variables Configuration

# Node.js Express Backend (Hugging Face / Cloud)
NODE_ENV=production
PORT=7860
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h
# (AI_SERVICE_URL is set internally to http://127.0.0.1:8000 by the start daemon)

# Python FastAPI AI Microservice (Hugging Face / Cloud)
AI_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database (Neon Serverless DB / Cloud)
# When deploying to Neon, set these environment variables (or secrets on Hugging Face):
DB_HOST=your-neon-hostname.neon.tech
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=neondb

# React Frontend (Vite / Netlify)
# When deploying frontend, set these build-time environment variables:
VITE_API_URL=https://your-username-your-space-name.hf.space/api



