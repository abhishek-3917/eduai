# Global Environment Variables Configuration

# Node.js Express Backend (Koyeb / Cloud)
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h
AI_SERVICE_URL=https://your-ai-service.koyeb.app # Set to your deployed AI service URL

# Python FastAPI AI Microservice (Koyeb / Cloud)
AI_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database (Neon Serverless DB / Cloud)
# When deploying to Neon or other cloud Postgres providers, use either DB_HOST/DB_PORT/etc or DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DB_HOST=your-neon-hostname.neon.tech
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=neondb

# React Frontend (Vite / Netlify)
# When deploying frontend, set these build-time environment variables:
VITE_API_URL=https://your-backend-service.koyeb.app/api
VITE_AI_URL=https://your-ai-service.koyeb.app


